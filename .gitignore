# Ignore Python virtual environments
venv/
# Ignore editor and system files
.cursor-server/
.cursor/
.cache/
.config/
.local/
logs/
# Ignore OS files
.DS_Store
Thumbs.db
# Ignore Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
# Ignore other hidden files
.sudo_as_admin_successful
.bash_history
.bash_logout
.bashrc
.profile
.env
.venv
# Ignore Sound files directory
/SoundFiles
# Ignore Cloned Repos
/ZoltarSpeaks


# SSH access control — this repo IS the home directory, so these land in it.
# authorized_keys is not a secret, but who may log in is not repo content.
.ssh/

# Ad-hoc backups taken before editing a live file
*.bak-*
